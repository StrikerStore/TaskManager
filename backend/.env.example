# Local MySQL 8 (Windows service MySQL80). Create the database first:
#   CREATE DATABASE taskboard CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/taskboard

# Better Auth. BETTER_AUTH_URL is the address browsers use: the web app.
BETTER_AUTH_SECRET=change-me-generate-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3100
APP_URL=http://localhost:3100
PORT=4000

# Timezone for recurring-task trigger times (Railway servers run on UTC)
TZ=Asia/Kolkata
